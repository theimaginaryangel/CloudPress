server {
    listen 80;
    server_name {{ domain }};

    root /var/www/{{ domain }};
    index index.php index.html index.htm;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock; # Adjust PHP version as needed (Ubuntu 22.04 default is 8.1)
    }

    location ~ /\.ht {
        deny all;
    }

    # High-performance static asset caching for CloudFront & Browser
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform, max-age=2592000";
        add_header Access-Control-Allow-Origin "*";
        log_not_found off;
        access_log off;
    }
}
